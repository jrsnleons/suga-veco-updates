# Database (Local SQLite or Remote Turso Cloud)
TURSO_DATABASE_URL="file:data/veco.db"
TURSO_AUTH_TOKEN=""

# Optional Secret to protect /api/sync endpoint from unauthorized cron triggers
# (Can be passed via Authorization: Bearer <SECRET> or ?secret=<SECRET>)
CRON_SECRET=""

# CARTO Basemap API Key (Get a free key at https://carto.com/basemaps/apikey)
# Configured as server-side secret CARTO_API_KEY so it's never exposed in browser bundles
CARTO_API_KEY=""

# Optional Basemap Tile URL override (defaults to secure server proxy /api/tiles/{style}/{z}/{x}/{y}.png)
# NEXT_PUBLIC_BASEMAP_URL="https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=YOUR_KEY"
