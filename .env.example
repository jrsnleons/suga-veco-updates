# Turso Database Configuration (100% Free Cloud SQLite)
# Get these from https://turso.tech or using Turso CLI:
#   1. turso db create veco-db
#   2. turso db show veco-db --url
#   3. turso db tokens create veco-db
TURSO_DATABASE_URL=libsql://veco-db-yourusername.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: If TURSO_DATABASE_URL is not provided, the app will automatically
# use the local SQLite database at file:data/veco.db
